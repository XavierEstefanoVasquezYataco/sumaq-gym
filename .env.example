# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE VARIABLES DE ENTORNO: SUMAQ CENTER GYM
# ==============================================================================
# Copia este archivo como .env.local para tu entorno de desarrollo local.
# En Netlify, configura estas variables en:
# Site configuration > Environment variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SANITY CMS (Panel de Gestión /studio)
# ------------------------------------------------------------------------------
# ID del proyecto en Sanity (obtenible en https://manage.sanity.io)
NEXT_PUBLIC_SANITY_PROJECT_ID="tu_project_id_de_sanity"

# Dataset de contenido ('production' por defecto)
NEXT_PUBLIC_SANITY_DATASET="production"

# Versión de la API de Sanity (formato fecha YYYY-MM-DD)
NEXT_PUBLIC_SANITY_API_VERSION="2026-03-01"

# Token de lectura opcional si el dataset está configurado como privado.
# Si el dataset es público para lectura, este token puede dejarse vacío.
SANITY_API_READ_TOKEN=""

# ------------------------------------------------------------------------------
# 2. DOMINIO CANÓNICO Y ENTORNO DE PRODUCCIÓN
# ------------------------------------------------------------------------------
# Dominio oficial o URL de Netlify para resolución de URLs canónicas, Open Graph y Sitemap.
# En Netlify demo, usa https://<tu-sitio>.netlify.app
NEXT_PUBLIC_SITE_URL="https://tu-sitio-demo.netlify.app"

# ------------------------------------------------------------------------------
# 3. INTERRUPTOR DE MODO PROTOTIPO / PRODUCCIÓN APROBADA
# ------------------------------------------------------------------------------
# 'true': Activa el modo prototipo (cintillo superior visible, indexación bloqueada
#         con noindex/nofollow, robots.txt en Disallow: / y promociones de muestra en fallback).
# 'false': Activa PRODUCCIÓN APROBADA (cintillo oculto, indexación habilitada para las
#          4 rutas públicas, robots.txt permitiendo rastreo excepto en /studio, y
#          estado neutral elegante si no hay promociones activas).
NEXT_PUBLIC_IS_DEMO="true"

# ==============================================================================
# GUÍA RÁPIDA: CÓMO PASAR DE PROTOTIPO A PRODUCCIÓN EN NETLIFY
# ==============================================================================
# 1. En Netlify (Site configuration > Environment variables):
#    - Cambiar NEXT_PUBLIC_IS_DEMO = "false"
#    - Asignar NEXT_PUBLIC_SITE_URL = "https://tudominiooficial.com"
# 2. Configurar CORS en Sanity (https://manage.sanity.io > Project > API > CORS Origins):
#    - Añadir "https://tudominiooficial.com" (Allow credentials: true para Studio)
#    - Añadir "https://<nombre-sitio>.netlify.app"
# 3. Re-desplegar (Trigger deploy en Netlify).
# 4. Verificar en Google Rich Results Test (https://search.google.com/test/rich-results)
#    la validez del Schema JSON-LD de HealthClub.
# 5. Enviar el sitemap (https://tudominiooficial.com/sitemap.xml) a Google Search Console.
# ==============================================================================
